# ==============================================================================
# AgroIn – Environment Configuration (.env.example)
#
# Instructions:
# 1. Copy this file to `.env`:
#      cp .env.example .env
# 2. Fill in your actual credentials and field coordinates.
# 3. Never commit `.env` into git.
# ==============================================================================

# ── Application & Database ───────────────────────────────────────────────────
DATABASE_URL=sqlite:///./agro_in.db
DEBUG=False
SQL_ECHO=False
APP_TITLE=AgroIn Agricultural Monitoring API
APP_VERSION=0.2.0

# ── Farm & Parcel Location ───────────────────────────────────────────────────
# Set your farm name and exact GPS coordinates (obtain from Google Earth / Maps)
FARM_NAME=FIELD_01
FARM_LATITUDE=21.1458
FARM_LONGITUDE=79.0882

# Farm boundary polygon in GeoJSON-compatible [{lat, lng}, ...] JSON string.
# Example: 4 corner vertices defining the agricultural field boundaries:
FARM_BOUNDARY_JSON=[{"lat":21.1465,"lng":79.0875},{"lat":21.1472,"lng":79.0890},{"lat":21.1450,"lng":79.0898},{"lat":21.1445,"lng":79.0880}]

# ── Google Maps JavaScript API ───────────────────────────────────────────────
# Get key from: https://console.cloud.google.com/google/maps-apis
# Enable "Maps JavaScript API"
# Restrict the key to HTTP referrers (e.g., http://localhost:5173/*) in production
GOOGLE_MAPS_API_KEY=

# ── Generative AI & Disease Diagnosis ─────────────────────────────────────────
# "gemini" or "local"
DIAGNOSIS_BACKEND=gemini
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6LWePfwqgG7FJwDceCQxY3QPMUTFAeV9Ck0KwqnTUsZpw
GEMINI_MODEL=gemini-2.5-flash
LOCAL_MODEL_ENDPOINT=http://localhost:8080/v1/diagnose
KVK_CONFIDENCE_THRESHOLD=0.70

# ── Google Earth Engine (GEE) Preparation ─────────────────────────────────────
# Path to service account JSON key for Sentinel-2 / Landsat NDVI retrieval
GEE_SERVICE_ACCOUNT_KEY=

# ── Weather Caching & Agronomic Thresholds ───────────────────────────────────
# Seconds to cache weather responses from Open-Meteo (10 min = 600s)
WEATHER_CACHE_TTL_SECONDS=600

# Moisture thresholds (%)
SOIL_MOISTURE_LOW_THRESHOLD=30.0
SOIL_MOISTURE_MODERATE_THRESHOLD=60.0

# Rain probability threshold below which irrigation is evaluated as needed
RAIN_PROBABILITY_LOW_THRESHOLD=30.0

# Path to your Earth Engine Service Account key
GEE_SERVICE_ACCOUNT_KEY=b34701624cc3c3336ff14094ad2c0aa8fad540ab

# The email address of your service account (found in the JSON file)
GEE_SERVICE_ACCOUNT_EMAIL=ayushd2255@gmail.com